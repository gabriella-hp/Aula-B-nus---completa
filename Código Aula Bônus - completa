class Inicio(Scene):
    def construct(self):

        computador = SVGMobject("assets/Computador.svg")
        computador.set_color(WHITE)
        computador.scale(3)

        negativos = Table(
            [["-1,", "-2,", "-3,"],
             ["-4,", "-5,", "-6,"],
             ["-7,", "-8,", "-9..."]],
             line_config={"stroke_width":0},
            v_buff=0.3,
            h_buff=0.3,)
        negativos.scale(0.7)
        negativos.move_to([-0.9, 1.3, 0])

        self.play(Write(computador), run_time=1.5)
        self.play(Create(negativos), run_time=1.3)
        self.play(FadeOut(computador),
                  FadeOut(negativos), run_time=0.8)
        self.wait()


class ComplementoDeDois(Scene):
    def construct(self):

        complemento_de_dois = Text("Complemento de Dois")
        complemento_de_dois.set_color("#AA77C7")
        complemento_de_dois.scale(1.7)

        bits = ["0", "1", "0", "1"]

        bits_novos = ["1", "0", "1", "0"]

        caixas = VGroup()
        for i in range(len(bits)):
            quadrado = Square(color="#AA77C7")
            texto = Text(bits[i])
            texto.move_to(quadrado.get_center())
            texto.scale(1.6)
            dupla = VGroup(quadrado, texto)
            caixas.add(dupla)
        caixas.arrange(RIGHT, buff=0)
        caixas.move_to([0, -0.5, 0])

        seta = Triangle(color=YELLOW, fill_opacity=0.5)
        seta.scale(0.5)
        seta.move_to([-3, -1.9, 0])

        texto_novo0 = Text(bits_novos[0]).move_to(caixas[0].get_center())
        texto_novo0.scale(1.6)

        texto_novo1 = Text(bits_novos[1]).move_to(caixas[1].get_center())
        texto_novo1.scale(1.6)

        texto_novo2 = Text(bits_novos[2]).move_to(caixas[2].get_center())
        texto_novo2.scale(1.6)

        texto_novo3 = Text(bits_novos[3]).move_to(caixas[3].get_center())
        texto_novo3.scale(1.6)

        texto_novo4 = Text('1', color=YELLOW).move_to(caixas[3].get_center())
        texto_novo4.scale(1.6)

        mais_um = Text('+1', color=YELLOW)
        mais_um.scale(0.9)
        mais_um.move_to([3, 0.9, 0])


        self.play(Write(complemento_de_dois))
        self.wait(0.5)
        self.play(complemento_de_dois.animate.move_to([0, 2.3, 0]).scale(0.9))
        self.play(FadeIn(caixas))
        self.wait()
        self.play(FadeIn(seta),
                  FadeTransform(caixas[0][1], texto_novo0))
        self.play(seta.animate.move_to([-1, -1.9, 0]),
                  FadeTransform(caixas[1][1], texto_novo1))
        self.play(seta.animate.move_to([1, -1.9, 0]),
                  FadeTransform(caixas[2][1], texto_novo2)
        )
        self.play(seta.animate.move_to([3, -1.9, 0]),
                  FadeTransform(caixas[3][1], texto_novo3))
        self.play(FadeOut(seta))
        self.play(FadeIn(mais_um))
        self.play(FadeOut(mais_um),
                  FadeTransform(texto_novo3, texto_novo4))
        self.wait()
        self.play(FadeOut(complemento_de_dois),
                  FadeOut(caixas[0][0]),
                  FadeOut(caixas[1][0]),
                  FadeOut(caixas[2][0]),
                  FadeOut(caixas[3][0]),
                  FadeOut(texto_novo0),
                  FadeOut(texto_novo1),
                  FadeOut(texto_novo2),
                  FadeOut(texto_novo4))
        self.wait()


